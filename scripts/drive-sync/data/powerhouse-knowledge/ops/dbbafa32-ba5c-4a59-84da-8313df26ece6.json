  {
    "index": 3,
    "hash": "OE3XUjeq/6xSb+1Oi/SBTf1xVic=",
    "timestampUtcMs": "2026-08-20T08:45:35.232Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "The configuration documentation states it plainly: *\"Rows in this table are updated as variable instances are updated, meaning that only the last value of a process variable will be available.\"* Recovering intermediate values requires opting up to the `FULL` history level, which is also where the user-attributed User Operation Log lives \u2014 so attribution is off by default too.\n\nThis is destructive in-place update presented as history. The engine is doing what it says, but a record that keeps only the latest value cannot answer what a decision looked like when it was taken.\n\nIt is also the strongest available demonstration against a Camunda 7 estate, because no API call is needed: a default installation destroys prior state on its own, as a consequence of normal operation.",
        "updatedAt": "2026-08-20T08:45:35.232994Z"
      },
      "timestampUtcMs": "2026-08-20T08:45:35.232998Z"
    }
  },
