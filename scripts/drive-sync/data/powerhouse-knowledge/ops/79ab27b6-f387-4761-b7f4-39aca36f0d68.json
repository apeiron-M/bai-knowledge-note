  {
    "index": 3,
    "hash": "4tAgWbqhumKFForiNfLGZo4GZB0=",
    "timestampUtcMs": "2026-08-14T12:35:45.000Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "The `IReactorClient.subscribe(search, callback, view?)` method enables real-time document change listening. It accepts a `SearchFilter` (type, parentId, ids, slugs), a callback receiving `DocumentChangeEvent`, and optional `ViewFilter`. DocumentChangeEvent includes `type`, a `documents` array, and optional `context` with parentId/childId. `subscribe` emits only five `DocumentChangeType` values \u2014 `Created`, `Deleted`, `Updated`, `ChildAdded`, and `ChildRemoved`. `ParentAdded` and `ParentRemoved` exist in the `DocumentChangeType` enum but are not currently emitted by `subscribe`. Returns an unsubscribe function. For the internal event bus (via ReactorModule), subscribe to `ReactorEventTypes.JOB_READ_READY` for completed jobs or `SyncEventTypes.SYNC_FAILED` for sync failures. In GraphQL, real-time updates use the `documentChanges` subscription.\n\n_Corrected 2026-08-13 against Powerhouse v6.2.2-dev.45._",
        "updatedAt": "2026-08-14T12:35:45.000Z"
      },
      "timestampUtcMs": "2026-08-14T12:35:45.000Z"
    }
  },
