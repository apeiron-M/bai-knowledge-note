  {
    "index": 3,
    "hash": "EnIT8F3AW+P+yfrkwj3B7BMWumM=",
    "timestampUtcMs": "2026-08-20T08:45:03.480Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "Clause 3.4 of the Alfresco End User Agreement is explicit: *\"User may not use the workflow software to design, create or run other types of workflows, business processes and/or management tasks. A separate subscription for Alfresco Process Services (APS) software is required for any such uses.\"*\n\nThis converts a technical observation into a contractual one. The absence of a business-decision record in Alfresco is not merely something the vendor has not built \u2014 an Enterprise customer is *licensed out of* building it there. Clause 3.2(d) reinforces the boundary from the other side by prohibiting Enterprise deployments from being combined, called or linked with any Community Version.\n\nFor an integration argument this is unusually strong evidence: the gap cannot be closed in place by a determined customer, which is precisely when an external record layer stops being optional.",
        "updatedAt": "2026-08-20T08:45:03.480188Z"
      },
      "timestampUtcMs": "2026-08-20T08:45:03.480193Z"
    }
  },
