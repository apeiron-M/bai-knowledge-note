  {
    "index": 3,
    "hash": "g341tkswYr3rBlc5iv7Ot6lzUPg=",
    "timestampUtcMs": "2026-08-20T08:45:52.974Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "The Odoo 19 release notes state: *\"The non-restrictive audit trail has been made available by default for everyone.\"* The code sits in `addons/account` inside `odoo/odoo`, whose manifest declares `'license': 'LGPL-3'`, and a repository-scoped code search for `audit_trail` returns files only in the LGPL repository. There is no separate audit module among the Community addons.\n\nThe report tracks, per the documentation, *\"the date and time of the changes, the user who made the changes, the type of change, the previous value, and the updated value\"* \u2014 field-level attribution, shipped free.\n\nThis refutes the natural hypothesis about Odoo, which is that its open-core split puts audit behind the Enterprise paywall and thereby creates a sovereignty wedge. Audit falls entirely on the LGPL side, so that wedge does not exist.",
        "updatedAt": "2026-08-20T08:45:52.974136Z"
      },
      "timestampUtcMs": "2026-08-20T08:45:52.974140Z"
    }
  },
