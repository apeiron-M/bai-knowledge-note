      "input": {
        "content": "Vetra color tokens from vetra/colors.css (https://github.com/powerhouse-inc/design-systems/blob/main/vetra/colors.css). Light theme (:root): --primary: #04C161, --primary-foreground: #FFFFFF, --secondary: #F4F4F4, --secondary-foreground: #343839, --accent: #F3F5F7, --accent-foreground: #000000, --background: #FCFCFC, --foreground: #343839, --card: #FCFCFC, --card-foreground: #343839, --popover: #FFFFFF, --popover-foreground: #343839, --muted: #EFEFEF, --muted-foreground: #9EA0A1, --border: #D7D8D9, --input: #FFFFFF, --ring: #343839. Dark theme (.dark / [data-theme=\"dark\"]): --primary: #04C161 (unchanged), --primary-foreground: #FFFFFF, --secondary: #4F596F, --secondary-foreground: #A6B1C7, --accent: #373E4D, --accent-foreground: #F3F5F7, --background: #1B1E24, --foreground: #FCFCFC, --card: #252A34, --card-foreground: #F3F5F7, --popover: #1E222B, --popover-foreground: #FCFCFC, --muted: #343839, --muted-foreground: #6C7275, --border: #485265, --input: #1B1E24, --ring: #F3F5F7.",
