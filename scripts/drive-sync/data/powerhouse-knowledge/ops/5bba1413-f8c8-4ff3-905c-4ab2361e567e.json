  {
    "index": 3,
    "hash": "wv4uKezpz1Ms79PbnGlxBH4Owus=",
    "timestampUtcMs": "2026-08-20T08:45:48.037Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "The documentation states that *\"Automatic cleanup of HistoricProcessInstances is disabled by default\"*, and that when enabled *\"the default is to run a cleanup job at 1 AM to delete all HistoricProcessInstances and associated data that have ended 365 days prior or older\"*.\n\nThis corrects a claim held earlier in this vault. Flowable's history is deletable \u2014 six documented `HistoryService` methods plus raw SQL deletes \u2014 but it is not deleted on its own. Purging is a deliberate administrative act, not drift.\n\nThe distinction matters when the argument is put to someone who runs the product. \"Your history will quietly disappear\" is refutable in one sentence; \"your history is mutable and erasable, and nothing detects either\" is not.",
        "updatedAt": "2026-08-20T08:45:48.037129Z"
      },
      "timestampUtcMs": "2026-08-20T08:45:48.037134Z"
    }
  },
