  {
    "index": 3,
    "hash": "jZigaB879CSabJXdzL+pOJyLR5Q=",
    "timestampUtcMs": "2026-08-20T08:45:00.801Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "The webscript descriptor for `/api/audit/clear/{application}` documents `fromTime` as *\"omit to assume oldest\"* and `toTime` as *\"omit to assume current time\"*. Both being optional means `POST /api/audit/clear/alfresco-access` with no parameters is a complete, sanctioned erasure of that application's audit history in a single call.\n\nTwo things compound it. There is no retention or pruning mechanism anywhere in the audit subsystem, so the table grows unbounded and manual deletion is the only management path \u2014 no defensible expiry policy, and no protection from wholesale removal. And `alf_audit_entry` is a plain table with an integer primary key: no hash chain, no previous-row digest, no signature column, no append-only trigger.\n\nNothing in the schema can distinguish a tampered audit trail from an untampered one, because there is no integrity constraint to violate.",
        "updatedAt": "2026-08-20T08:45:00.801536Z"
      },
      "timestampUtcMs": "2026-08-20T08:45:00.801541Z"
    }
  },
