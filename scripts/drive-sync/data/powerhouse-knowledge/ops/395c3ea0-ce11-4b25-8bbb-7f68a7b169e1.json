  {
    "index": 3,
    "hash": "2/pg/zzEAtPAYzl/M/Tou1mhVt8=",
    "timestampUtcMs": "2026-08-14T12:35:43.000Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "The `IReactorClient` interface wraps `IReactor` to provide a simpler Promise-based API. Key differences: IReactorClient write methods wait for `READ_READY` status before resolving (returning final documents), while IReactor returns `JobInfo` immediately. IReactorClient manages signing internally and handles consistency tokens automatically; IReactor requires explicit `ISigner` and manual token passing. IReactorClient provides convenience methods like `createEmpty()`, `rename()`, `moveRelationship()`, and `deleteDocuments()`; to create a document inside a drive, use `client.drives.addFile()`, which issues CREATE_DOCUMENT, UPGRADE_DOCUMENT, ADD_RELATIONSHIP, and ADD_FILE in a single dependent batch. IReactorClient offers `subscribe(search, callback)` for real-time changes; IReactor requires direct event bus access. Use IReactor when you need fire-and-forget jobs, explicit consistency token control, custom signing, or `executeBatch()` for multi-document atomic operations.\n\n_Corrected 2026-08-13 against Powerhouse v6.2.2-dev.45._",
        "updatedAt": "2026-08-14T12:35:43.000Z"
      },
      "timestampUtcMs": "2026-08-14T12:35:43.000Z"
    }
  },
