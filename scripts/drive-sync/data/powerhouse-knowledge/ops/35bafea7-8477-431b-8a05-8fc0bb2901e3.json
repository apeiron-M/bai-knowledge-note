  {
    "index": 3,
    "hash": "3RcjI1zw57llQJ1xqNlRpFCokW0=",
    "timestampUtcMs": "2026-08-20T08:45:21.839Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "The ERPNext manual describes enabling it: *\"Go to Purchase Order List. Click on Customize from the drop-down menu... Check the field 'Track changes' in the Properties.\"* The framework's `save_version()` checks `track_changes` on the document meta before writing anything.\n\nSo coverage is a per-DocType configuration decision rather than a platform guarantee. Whether a given business event is recorded depends on whether somebody thought to tick a box on that doctype, and there is no signal at the point of the event that it went unrecorded.\n\nCombined with version history being deleted alongside its document, the practical answer to \"is this decision recorded?\" in a Frappe deployment is: only if configured, and only until the record is removed.",
        "updatedAt": "2026-08-20T08:45:21.839125Z"
      },
      "timestampUtcMs": "2026-08-20T08:45:21.839134Z"
    }
  },
