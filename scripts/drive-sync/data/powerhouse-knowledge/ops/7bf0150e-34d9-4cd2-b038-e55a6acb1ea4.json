  {
    "index": 3,
    "hash": "8QATQxUXxzs2BOTP98Wzx2H8wuM=",
    "timestampUtcMs": "2026-08-14T12:35:49.000Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "To enable timeline in an editor, the editor module exports the configuration and the Drive-app or default app fetches timeline items via `useTimelineItems(documentId)` from `@powerhousedao/reactor-browser/analytics`. When a user clicks a timeline candle, `getRevisionFromDate(startDate, endDate, operations.global)` resolves the revision number. The editor receives `context.readMode = true` and `context.selectedTimelineRevision`. The editor then calls `getDocumentRevision({ revisions: { global: selectedTimelineRevision } })` to fetch the document at that point in time and disables edit controls. The timeline only activates once a document has some operation history.\n\n_Corrected 2026-08-13 against Powerhouse v6.2.2-dev.45._",
        "updatedAt": "2026-08-14T12:35:49.000Z"
      },
      "timestampUtcMs": "2026-08-14T12:35:49.000Z"
    }
  },
