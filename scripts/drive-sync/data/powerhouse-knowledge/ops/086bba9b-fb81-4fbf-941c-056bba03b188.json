  {
    "index": 3,
    "hash": "IAjR0y81D45eT/FV/uN+ZT+bz4Y=",
    "timestampUtcMs": "2026-08-20T08:45:37.654Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "From the history-cleanup documentation: *\"The history time to live is mandatory, any deployment or re-deployment of any model resource (BPMN, DMN, CMMN) that contains a historyTimeToLive of null will be prevented.\"*\n\nCleanup itself is opt-in \u2014 no cleanup window is configured by default, so nothing is actually removed until an administrator schedules it. But the declaration is compulsory: you cannot deploy a process without stating a date on which its history becomes disposable.\n\nIt is a revealing design choice. The engine treats process history as operational data with a lifespan, to the point of refusing work that declines to specify one. That is a coherent position for an orchestrator and an incompatible one for a system of record.",
        "updatedAt": "2026-08-20T08:45:37.654418Z"
      },
      "timestampUtcMs": "2026-08-20T08:45:37.654422Z"
    }
  },
