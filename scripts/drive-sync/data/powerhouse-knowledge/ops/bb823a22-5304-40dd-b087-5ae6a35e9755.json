    "action": {
      "type": "ADD_RELATIONSHIP",
      "input": {
        "metadata": {
          "reason": "The outbox-add flow presents batch aggregation as complete-batch-then-route, but a job failure inside the aggregation window emits a partial batch that is indistinguishable from a complete one",
          "confidence": "grounded"
        },
        "sourceId": "bb823a22-5304-40dd-b087-5ae6a35e9755",
        "targetId": "9c453091-8c7b-4210-af2f-600fead66af7",
