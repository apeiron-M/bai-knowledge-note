  {
    "index": 3,
    "hash": "Dsqf392f7CPDSxGM/I+e2fpCLKo=",
    "timestampUtcMs": "2026-08-20T08:45:13.927Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "`execution_entity` carries `id`, `status`, `mode`, `createdAt`, `startedAt` and a `DeleteDateColumn` for soft deletion. `mode` is an enum over how the run was triggered: `webhook`, `trigger`, `manual`, `cli`, `retry`. The payload sits in `execution_data` as a single `text` blob, cascade-deleted with its parent row.\n\nNowhere in either entity is there a field for the deciding actor, the rule applied, or the prior state. An execution is attributed to a *workflow* \u2014 to the automation that ran, not to the person on whose authority it ran.\n\nThis is the structural reason an n8n execution log cannot answer \"who approved this, under which rule\", independently of retention. Even a run preserved forever would not carry the attribution.",
        "updatedAt": "2026-08-20T08:45:13.927502Z"
      },
      "timestampUtcMs": "2026-08-20T08:45:13.927507Z"
    }
  },
