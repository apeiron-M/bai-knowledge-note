  {
    "index": 3,
    "hash": "BEngsGLEsimdShajlkobufKlrQg=",
    "timestampUtcMs": "2026-08-20T08:45:24.424Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "The documentation describes it as *\"A tool for viewing the changes made to a submittable doctype across multiple amended versions\"*, tracking *\"Fields Changed\"*, *\"Rows Updated\"* and *\"Rows Added / Rows Removed\"*. The page makes no assertion about default enablement, immutability, hashing, chaining or protection from deletion.\n\nThis is a useful feature with a misleading name for anyone screening tools by keyword. The same trap appears in n8n, whose `/audit` endpoint is a vulnerability scanner. In both cases the word \"audit\" in a feature name says nothing about whether an append-only record exists.\n\nThe check that actually discriminates is not whether a tool has something called an audit trail, but whether its records survive the deletion of what they describe.",
        "updatedAt": "2026-08-20T08:45:24.424662Z"
      },
      "timestampUtcMs": "2026-08-20T08:45:24.424666Z"
    }
  },
