  {
    "index": 3,
    "hash": "NcRIyaFIbcNNH+2tfMHm7RO8dDs=",
    "timestampUtcMs": "2026-08-14T12:35:33.000Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "A Powerhouse package bundles document models, editors, processors, and scripts. The NPM org naming convention is `@yourorganization-ph` (the `-ph` suffix identifies Powerhouse ecosystem packages). Workflow: `ph init` creates project, `ph vetra --interactive --watch` for development, `pnpm build` to verify, `pnpm version patch|minor|major` for semver, `pnpm publish --access public` to NPM. Installation: `ph install @org-ph/package-name` makes document models and editors available. `ph install` defaults to the **Powerhouse registry**: it only registers the package in `powerhouse.config.json` with provider `\"registry\"`, and Connect loads it from the registry CDN at runtime -- it does NOT install into `node_modules` by default. Use `--local` to also install into `node_modules` (provider `\"local\"`) so `ph connect build` bundles it and the preview works without the registry being reachable. Registry URL resolution order: `--registry` flag > `PH_REGISTRY_URL` env > `powerhouse.config.json` > default. The `powerhouse.manifest.json` file declares all modules (documentModels, editors, apps, subgraphs, importScripts). `ph install` also automatically adds package styles to `styles.css`.\n\n_Corrected 2026-08-13 against Powerhouse v6.2.2-dev.45._",
        "updatedAt": "2026-08-14T12:35:33.000Z"
      },
      "timestampUtcMs": "2026-08-14T12:35:33.000Z"
    }
  },
