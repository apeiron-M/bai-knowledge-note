  {
    "index": 3,
    "hash": "jiQr4DEmbdLNnEe/5OCvKetGvqU=",
    "timestampUtcMs": "2026-08-20T08:45:45.303Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "`HistoricProcessInstance.xml` defines `updateHistoricProcessInstance`, issuing `update ${prefix}ACT_HI_PROCINST` with `REV_`, `PROC_DEF_ID_`, `BUSINESS_KEY_` and `START_TIME_` among the assignable columns. Equivalent update mappers exist for historic task and activity instances.\n\nThe presence of a `REV_` optimistic-locking column is the strongest signal: rows carrying a revision counter are rows expected to change. This is mutability established from the engine's own source rather than inferred from the absence of a guarantee.\n\nIt also makes the sharpest possible demonstration. A hand-written `UPDATE` against that table is indistinguishable from the engine's own behaviour \u2014 same statement shape, same revision increment, no gap and no tamper indicator \u2014 because legitimate rewrites are how the component works.",
        "updatedAt": "2026-08-20T08:45:45.303833Z"
      },
      "timestampUtcMs": "2026-08-20T08:45:45.303838Z"
    }
  },
