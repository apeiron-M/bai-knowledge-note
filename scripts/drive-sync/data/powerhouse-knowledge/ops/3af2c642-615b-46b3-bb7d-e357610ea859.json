    "timestampUtcMs": "2026-09-03T07:30:27.345Z",
    "action": {
      "type": "ADD_RELATIONSHIP",
      "input": {
        "metadata": {
          "reason": "Each element of the stack answers one of the three reasons the actionId break went undetected: no schema checking, no runtime decode, no mapping assertions",
          "confidence": "grounded"
        },
        "sourceId": "3af2c642-615b-46b3-bb7d-e357610ea859",
        "targetId": "12279c44-5030-4886-b208-f4247e648a4c",
