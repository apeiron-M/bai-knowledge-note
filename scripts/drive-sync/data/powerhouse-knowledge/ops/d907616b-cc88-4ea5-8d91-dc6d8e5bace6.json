  {
    "index": 3,
    "hash": "SwMOOypoOnF5M5XMb4MIxJq5fZk=",
    "timestampUtcMs": "2026-08-14T12:34:56.000Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "Running `ph login` generates a cryptographic keypair (ECDSA P-256) stored in `.ph/.keypair.json`, creates a DID in `did:key:...` format, opens the browser to Renown portal for the user to authorize the CLI DID to act on behalf of their Ethereum address, and stores the credentials in `.ph/.renown.json`. Identity files live under a `.ph` directory, but they are not strictly per-project: `ph switchboard --use-identity` reads the keypair from `~/.ph/keypair.json` (a global location), and `--keypair-path` can point at a custom keypair file. The Switchboard uses identity via `ph switchboard --use-identity` to authenticate with remote drives (generate bearer tokens), sign operations, and present its DID to remote services. CI/CD environments can provide the keypair via `PH_RENOWN_PRIVATE_KEY` environment variable (a JSON-encoded JWK keypair). The CLI DID cannot sign Ethereum transactions or access the wallet -- it can only authenticate with Renown-trusting services.\n\n_Corrected 2026-08-13 against Powerhouse v6.2.2-dev.45._",
        "updatedAt": "2026-08-14T12:34:56.000Z"
      },
      "timestampUtcMs": "2026-08-14T12:34:56.000Z"
    }
  },
