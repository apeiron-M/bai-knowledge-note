  {
    "index": 3,
    "hash": "cBThyzn0z8MHoG1S2o/2pKMPG2I=",
    "timestampUtcMs": "2026-08-30T18:29:57.285Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "In x402, a **facilitator** is a trusted service provider that handles payment verification and settlement for sellers who don't want to run those functions themselves. Resource servers call the facilitator's `/verify` and `/settle` endpoints instead of watching chains directly.\n\n**Why it matters:** this is the adoption lever \u2014 a web service can start charging per request without holding keys, running nodes, or understanding onchain settlement. It mirrors how payment processors abstracted card networks for web commerce.\n\n**Trade-off:** it reintroduces a trusted party into an otherwise permissionless flow; servers can still verify independently if they prefer.\n\nSource: x402 docs introduction (https://docs.x402.org/introduction).",
        "updatedAt": "2026-08-30T12:10:00.000Z"
      },
      "timestampUtcMs": "2026-08-30T18:29:57.285Z"
    }
  },
