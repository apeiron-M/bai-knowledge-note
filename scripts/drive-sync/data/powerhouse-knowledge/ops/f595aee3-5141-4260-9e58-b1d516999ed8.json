    "action": {
      "type": "SET_DESCRIPTION",
      "input": {
        "updatedAt": "2026-09-03T07:20:12.399Z",
        "description": "The criterion is whether the reactor can serve the bytes now, not whether it has seen the hash. An available hash returns AttachmentAlreadyExists and sends nothing; an evicted one gets restored."
