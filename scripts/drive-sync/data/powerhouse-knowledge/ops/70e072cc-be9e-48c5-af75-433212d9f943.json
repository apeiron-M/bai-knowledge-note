  {
    "index": 3,
    "hash": "qdXOhl0uOYGFdrDaGS38YQY8LM0=",
    "timestampUtcMs": "2026-08-20T08:45:06.024Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "The registered policy interfaces are `BeforeCreateNodePolicy`, `OnCreateNodePolicy`, `OnMoveNodePolicy`, `OnUpdatePropertiesPolicy`, `OnAddAspectPolicy`, `BeforeDeleteNodePolicy` and their siblings. Every one is keyed to a document verb.\n\nThere is no `OnDecisionPolicy` and no `OnApprovalPolicy` \u2014 no business-event vocabulary anywhere in the extension surface. An integration that wants to capture \"this application was accepted\" has to infer it from an aspect being added or a property changing, which is the impedance mismatch stated in the platform's own API.\n\nThe vocabulary of a tool's extension points is a reliable predictor of what it can record. Where the hooks are node verbs, the records will be node events, however the feature is marketed.",
        "updatedAt": "2026-08-20T08:45:06.024295Z"
      },
      "timestampUtcMs": "2026-08-20T08:45:06.024300Z"
    }
  },
