      "type": "SET_DESCRIPTION",
      "input": {
        "updatedAt": "2026-08-13T14:38:22.000Z",
        "description": "reactorClient.execute() waits for the job to reach READ_READY, so it can wait on the very processor making the call. Use the injected dispatch instead."
      },
      "timestampUtcMs": "2026-08-13T14:38:23.893Z"
    }
  },
