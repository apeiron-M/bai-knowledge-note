    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "The Inspector Modal is a Connect development tool with two tabs: Database (explore local PGlite tables with schema tree, pagination, sorting, and export/import) and Remotes (view sync remotes and their channel states). Each remote has Inbox (received operations), Outbox (pending send), and Dead Letter (failed sync with error info). Operations have statuses: Pending, Applied, or Error. The Inspector is generally available to every Connect user \u2014 there is no feature flag. To open it, click the **Settings** (gear) button in the Connect sidebar footer, select the **About** tab, then click **Open Inspector**.\n\n_Corrected 2026-08-13 against Powerhouse v6.2.2-dev.45._",
        "updatedAt": "2026-08-13T14:10:26.000Z"
      },
      "timestampUtcMs": "2026-08-13T14:10:43.055Z"
    }
  },
