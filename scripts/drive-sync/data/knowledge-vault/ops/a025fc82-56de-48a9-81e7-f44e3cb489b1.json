    "action": {
      "type": "UPDATE_ORIENTATION",
      "input": {
        "updatedAt": "2026-08-13T14:11:19.000Z",
        "orientation": "The DocumentToolbar exposes three independent styling layers. The containers accept toolbarClassName and controlsContainerClassName with twMerge for conflict resolution, and can be replaced outright via toolbarContainer / controlsContainer. Internal buttons accept ToolbarButtonProps (document, children, className, onClick) and are exported individually, so they are restyled directly and passed back through componentOverrides. Revision history renders outside the editor tree, requiring scoped CSS. This topic is part of the Editors and UX domain.\n\n_Corrected 2026-08-13 against Powerhouse v6.2.2-dev.45._"
      },
      "timestampUtcMs": "2026-08-13T14:11:19.494Z"
    }
  },
