  {
    "index": 8,
    "hash": "Np6sp5k9gepf2gX7Ht6VtXs50Xo=",
    "timestampUtcMs": "2026-08-13T14:10:30.642Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "The `ReactorBuilder` from `@powerhousedao/reactor` provides a fluent API for constructing reactors: `withDocumentModelSources(sources)` (which accepts live document-model modules, importable `{ filePath }` files, and importable `{ packageName }` packages), `withExecutorConfig({ maxConcurrency, jobTimeoutMs })`, `withWriteCacheConfig({ maxDocuments, ringBufferSize })`, `withMigrationStrategy('auto')`, `withKysely()` (defaults to in-memory PGlite), `withQueue()` (defaults to InMemoryQueue), `withEventBus()`, `withReadModel()`, `withSync()`, and more. Calling `build()` returns `IReactor`; calling `buildModule()` returns an `InProcessReactorModule` exposing all internal components including operationStore, keyframeStore, writeCache, documentView, documentIndexer, readModelCoordinator, processorManager, and the underlying Kysely database. The base `ReactorModule` interface it extends carries only three fields (`documentModelRegistry`, `syncModule`, `eventBus`) \u2014 the subset a client can resolve regardless of where the reactor graph lives.\n\n_Corrected 2026-08-13 against Powerhouse v6.2.2-dev.45._",
        "updatedAt": "2026-08-13T14:10:18.000Z"
      },
      "timestampUtcMs": "2026-08-13T14:10:30.642Z"
    }
  },
