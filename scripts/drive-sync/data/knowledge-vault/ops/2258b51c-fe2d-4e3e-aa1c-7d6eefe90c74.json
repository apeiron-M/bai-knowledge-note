  },
  {
    "index": 10,
    "hash": "S/TDwvzblvvonvHJ7KUqTuQRGlI=",
    "timestampUtcMs": "2026-08-13T14:13:40.086Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "Three official images on `ghcr.io/powerhouse-inc/powerhouse/`: connect (Alpine + Node + Nginx with Brotli), switchboard (Node 24 + Prisma), academy (docs). Tags: latest, dev, staging, vX.Y.Z. Docker Compose stack: connect + switchboard + postgres:16.1. Connect startup: load packages from `PH_REGISTRY_PACKAGES`, `ph connect build`, configure/start Nginx. Switchboard startup: install packages from `PH_PACKAGES`, run Prisma migrations (only if `PH_REACTOR_DATABASE_URL` is set), start the server. Custom packages use a different env var per service: Connect reads `PH_REGISTRY_PACKAGES` (comma-separated, written to a registry config at startup), Switchboard reads `PH_PACKAGES` (comma-separated). Production: use specific version tags, persist postgres with volumes, bind to 127.0.0.1 behind a reverse proxy for SSL termination. `DATABASE_URL` is Switchboard-only -- Connect never uses it -- and it accepts a PostgreSQL *or* SQLite connection string (default `\"dev.db\"`).\n\n_Corrected 2026-08-13 against Powerhouse v6.2.2-dev.45._",
        "updatedAt": "2026-08-13T14:13:03.000Z"
      },
      "timestampUtcMs": "2026-08-13T14:13:40.086Z"
    }
  },
