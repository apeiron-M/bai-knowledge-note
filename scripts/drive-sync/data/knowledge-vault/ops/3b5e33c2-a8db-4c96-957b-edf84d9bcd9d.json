    "timestampUtcMs": "2026-08-13T14:10:34.038Z",
    "action": {
      "type": "SET_DESCRIPTION",
      "input": {
        "updatedAt": "2026-08-13T14:10:18.000Z",
        "description": "Subscribe with a SearchFilter (type/parentId/ids/slugs) and a callback; subscribe emits only Created, Deleted, Updated, ChildAdded, ChildRemoved. Returns an unsubscribe function."
      },
      "timestampUtcMs": "2026-08-13T14:10:34.038Z"
    }
  },
