  {
    "index": 9,
    "hash": "7RdXyEOsC/9Bdz3ToWK+W9poPnQ=",
    "timestampUtcMs": "2026-08-13T14:10:29.570Z",
    "action": {
      "type": "SET_CONTENT",
      "input": {
        "content": "The `ReactorClient` holds an `ISigner` instance and every mutation method (`execute()`, `create()`, `createEmpty()`, `rename()`, `addRelationship()`, `removeRelationship()`, `moveRelationship()`) calls `signActions()` internally before submission. If `action.context.signer.signatures` already has entries, the action passes through unchanged. `ReactorClientBuilder.withSigner()` accepts an `ISigner` or `SignerConfig` (signer + optional verifier). Without a signer, `PassthroughSigner` is used (no-op, empty signatures). The production implementation is `RenownCryptoSigner` from the `renown` package, using ECDSA P-256 with `did:key` identity. Signature verification is optional and runs in the reactor's executor pipeline via `SignatureVerifier`.\n\n_Corrected 2026-08-13 against Powerhouse v6.2.2-dev.45._",
        "updatedAt": "2026-08-13T14:10:18.000Z"
      },
      "timestampUtcMs": "2026-08-13T14:10:29.570Z"
    }
  },
